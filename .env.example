# Hugging Face token (Inference Providers) for AI generation.
# - Images: used first when set; falls back to Pollinations.ai on failure.
# - Text: used when CLAUDE_API_KEY is not set.
# The token needs the "Make calls to Inference Providers" permission.
HF_TOKEN=hf_...

# Optional model overrides
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Claude API Key for text generation (Anthropic) — optional, takes priority over HF for text
CLAUDE_API_KEY=sk-ant-...

# Telegram Bot for backup (optional)
TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# Vercel Blob token for logo storage (optional)
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# PostgreSQL connection string (on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:5432/dbname
