# AI generation (text and images) uses Pollinations.ai with free open-source
# models. No API key is required.
#
# Optional: override the text model (default: openai-fast = GPT-OSS 20B)
# POLLINATIONS_TEXT_MODEL=openai-fast
# Optional: reasoning effort for the text model (low | medium | high | off). Default: low (fastest)
# POLLINATIONS_REASONING_EFFORT=low

# Optional: Pollinations account key (from enter.pollinations.ai). With a key,
# generated images come without the Pollinations logo and without the per-IP limit.
# Without it, the free anonymous tier is used and images carry the logo.
# POLLINATIONS_API_KEY=sk_...

# Telegram Bot for backup (optional)
TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# PostgreSQL connection string (on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Administration (/admin) ───────────────────────────────────────────────
# Password for the admin panel (minimum 10 characters). Without it, /admin is disabled.
ADMIN_PASSWORD=

# ─── Optional AI providers (selectable in /admin once their variable is set) ─
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama: base URL of a server reachable from this app, e.g. https://ollama.example.com
# OLLAMA_BASE_URL=
